<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The only permission: the Home Assistant server named in config.json, on the home network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- usesCleartextTraffic: Home Assistant on the LAN is usually plain http (camera snapshots). -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <activity
            android:name=".PanelActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- The install script writes config.json (server and token) through this.
             WRITE_SECURE_SETTINGS: the adb shell has it, ordinary apps don't. -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="${applicationId}.config"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
    </application>
</manifest>
